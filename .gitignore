# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NOTE: src/firebase/config.ts is intentionally NOT ignored.
# It only holds the public, client-side Firebase Web App config (safe to expose
# in the browser bundle) and is imported unconditionally by src/firebase/index.ts.
# Firebase App Hosting builds from this same source tree, so ignoring this file
# breaks production builds ("Module not found: Can't resolve '@/firebase/config'").
# Actual access control lives in firestore.rules, not in hiding this file.

# Firebase service account / admin SDK credentials
*firebase-adminsdk*.json
serviceAccountKey.json
*service-account*.json
firebase-debug.log
firestore-debug.log
ui-debug.log

# Google Application Default Credentials (if ever generated locally)
.config/gcloud/
application_default_credentials.json

# IDE / editor local settings that can leak machine-specific paths
.vscode/*
!.vscode/extensions.json

# OS
Thumbs.db
